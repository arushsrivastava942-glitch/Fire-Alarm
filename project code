// Pin Definitions
const int flameSensorPin = 2; // Digital pin connected to flame sensor
const int buzzerPin = 8;      // Digital pin connected to buzzer
const int ledPin = 9;         // Digital pin connected to LED

void setup() {
  pinMode(flameSensorPin, INPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(ledPin, OUTPUT);
  
  Serial.begin(9600); // Initialize Serial Monitor for debugging
}

void loop() {
  // Read sensor state (Most flame sensors output LOW when flame is detected)
  int flameState = digitalRead(flameSensorPin);

  if (flameState == LOW) { // Flame detected
    Serial.println("WARNING: Fire Detected!");
    
    digitalWrite(ledPin, HIGH); // Turn ON LED
    
    // Sound the buzzer (frequency: 1000 Hz)
    tone(buzzerPin, 1000); 
    
  } else { // No flame detected
    Serial.println("Status: Safe");
    
    digitalWrite(ledPin, LOW); // Turn OFF LED
    noTone(buzzerPin);         // Turn OFF Buzzer
  }

  delay(200); // Short delay for stability
}
